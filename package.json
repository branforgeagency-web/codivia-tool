{
  "name": "codivia-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Medical-coding practice platform: students code real-format charts, get scored with a reason, track progress, and build a certificate and resume. Admins allocate charts and review performance; auditors have a read-only view.",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && firebase deploy --only hosting",
    "export-charts": "node tools/export-charts-json.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx}\""
  },
  "keywords": [
    "medical-coding",
    "icd-10",
    "cpt",
    "hcpcs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "firebase": "11.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "3.3.3",
    "vite": "^7.3.7"
  }
}
