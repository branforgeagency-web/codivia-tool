NODE_ENV=development
PORT=3000

MONGODB_URL=mongodb://127.0.0.1:27017/codivia

# Comma separated. The frontend dev server runs on 8080.
CORS_ORIGIN=http://localhost:8080

JWT_ACCESS_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-of-32-plus-chars
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

BCRYPT_SALT_ROUNDS=12

ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Change-me@123

# S3 media storage (POST /api/v1/media-upload)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=codivia
AWS_S3_PUBLIC_URL=https://codivia.s3.ap-south-1.amazonaws.com
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
